      "title": "Stretch sideways",
      "version": 1,
      "screens": [
        {
          "id": "every",
          "prompt": "A tiny drawing is a few points. The same matrix moves...",
          "primitive": {
            "type": "choice",
            "options": [
              {
                "id": "a",
                "label": "Every point"
              },
              {
                "id": "b",
                "label": "Only the first point"
              }
            ],
            "correctOptionId": "a"
          },
          "feedback": {
            "wrong_option": "One table applies to every point in the drawing."
          },
          "easyWithinMs": 8000,
          "correctMessage": "Every point uses the same warp."
        },
        {
          "id": "wide",
          "prompt": "Use 2, 0 / 0, 1 to stretch the drawing sideways.",
          "primitive": {
            "type": "matrixWarp",
            "target": [
              2,
              0,
              0,
              1
            ],
            "initial": [
              0,
              0,
              0,
              0
            ],
            "tolerance": 0.1,
            "showTarget": true
          },
          "feedback": {
            "wrong_cell": "Top left is 2, bottom right is 1, and the other cells stay 0."
          },
          "easyWithinMs": 12000,
          "correctMessage": "That stretch doubles width."
        },
        {
          "id": "corner",
          "prompt": "A corner at x = 1 moves to...",
          "primitive": {
            "type": "slider",
            "min": 0,
            "max": 10,
            "step": 1,
            "correctValue": 2,
            "tolerance": 0
          },
          "feedback": {
            "too_low": "x doubles. Move higher.",
            "too_high": "x doubles to less than that. Move lower."
          },
          "easyWithinMs": 10000,
          "correctMessage": "The corner's x is 2."
        },
        {
          "id": "travel",
          "prompt": "That corner travels from (1, 2) to (2, 2). Drag the tip.",
          "primitive": {
            "type": "dragArrow",
            "planeWidth": 10,
            "planeHeight": 10,
            "start": {
              "x": 1,
              "y": 2
            },
            "targetTip": {
              "x": 2,
              "y": 2
            },
            "tolerance": 0.8
          },
          "feedback": {
            "wrong_direction": "The corner moves straight right.",
            "wrong_length": "The aim is right. x grows from 1 to 2."
          },
          "easyWithinMs": 12000,
          "correctMessage": "The corner moved with the stretch."
        },
        {
          "id": "shape",
          "prompt": "The height stays put. The drawing gets...",
          "primitive": {
            "type": "choice",
            "options": [
              {
                "id": "a",
                "label": "Wider"
              },
              {
                "id": "b",
                "label": "Taller"
              }
            ],
            "correctOptionId": "a"
          },
          "feedback": {
            "wrong_option": "y is multiplied by 1. Only x grows, so the drawing gets wider."
          },
          "easyWithinMs": 8000,
          "correctMessage": "Width grows. Height stays."
        }
      ],
      "capstone": false,
      "whyItMatters": "Features move together when a matrix warps space."
    },
