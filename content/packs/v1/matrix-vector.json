    {
      "id": "30000000-0000-4000-8000-000000000029",
      "skillNodeId": "20000000-0000-4000-8000-000000000013",
      "title": "Double x",
      "version": 1,
      "screens": [
        {
          "id": "which",
          "prompt": "The matrix 2, 0 / 0, 1 doubles which coordinate?",
          "primitive": {
            "type": "choice",
            "options": [
              {
                "id": "a",
                "label": "x"
              },
              {
                "id": "b",
                "label": "y"
              },
              {
                "id": "c",
                "label": "Both, by the same amount"
              }
            ],
            "correctOptionId": "a"
          },
          "feedback": {
            "wrong_option": "The bottom right is 1, so y stays. Both would need two 2s."
          },
          "easyWithinMs": 8000,
          "correctMessage": "x doubles. y stays."
        },
        {
          "id": "set",
          "prompt": "Set the table that doubles x and leaves y.",
          "primitive": {
            "type": "matrixWarp",
            "target": [
              2,
              0,
              0,
              1
            ],
            "initial": [
              0,
              0,
              0,
              0
            ],
            "tolerance": 0.1
          },
          "feedback": {
            "wrong_cell": "Top left doubles x. Bottom right keeps y. The other cells stay 0."
          },
          "easyWithinMs": 12000,
          "correctMessage": "That table doubles x."
        },
        {
          "id": "x",
          "prompt": "x doubles. Start at x = 3. Set the new x.",
          "primitive": {
            "type": "slider",
            "min": 0,
            "max": 10,
            "step": 1,
            "correctValue": 6,
            "tolerance": 0
          },
          "feedback": {
            "too_low": "3 doubled is higher. Move up.",
            "too_high": "3 doubled is lower. Move down."
          },
          "easyWithinMs": 10000,
          "correctMessage": "x lands at twice the start."
        },
        {
          "id": "y",
          "prompt": "Its y, under 2, 0 / 0, 1, ...",
          "primitive": {
            "type": "choice",
            "options": [
              {
                "id": "a",
                "label": "Stays the same"
              },
              {
                "id": "b",
                "label": "Doubles too"
              }
            ],
            "correctOptionId": "a"
          },
          "feedback": {
            "wrong_option": "The matrix multiplies y by 1."
          },
          "easyWithinMs": 8000,
          "correctMessage": "y is unchanged."
        },
        {
          "id": "move",
          "prompt": "From (2, 3), x doubles and y stays. Drag the tip.",
          "primitive": {
            "type": "dragArrow",
            "planeWidth": 10,
            "planeHeight": 10,
            "start": {
              "x": 2,
              "y": 3
            },
            "targetTip": {
              "x": 4,
              "y": 3
            },
            "tolerance": 0.8,
            "showTarget": false
          },
          "feedback": {
            "wrong_direction": "x doubles, so the move is straight right.",
            "wrong_length": "The aim is right. x grows and y stays."
          },
          "easyWithinMs": 12000,
          "correctMessage": "The point slid right."
        }
      ],
      "capstone": false,
      "whyItMatters": "A layer stretches the input this way."
    },
